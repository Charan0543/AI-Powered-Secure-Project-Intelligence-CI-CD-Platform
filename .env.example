# ==============================================================================
# Nexorian Environment Configuration Example
# ==============================================================================

DATABASE_URL="file:./dev.db"
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Email / SMTP Configuration
# Development default: Mailpit local SMTP server (port 1025)
# Production: Set host, port (465/587), user, pass, and secure=true
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Nexorian Security <security@nexorian.internal>"

# Mailpit Web UI URL for local developer inspection
MAILPIT_WEB_URL="http://localhost:8025"
